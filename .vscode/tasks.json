    {
      "label": "watch",
      "type": "typescript",
      "tsconfig": "tsconfig.json",
      "option": "watch",
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": "$tsc-watch"
    }
  ]
}